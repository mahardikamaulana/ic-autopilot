{
  "name": "ic-autopilot",
  "private": true,
  "version": "0.0.0",
  "description": "IC Autopilot: userscript toolkit for idlecorp.net (build + tests; the shipped file is ic-autopilot.user.js)",
  "scripts": {
    "build": "bun build.js",
    "check": "bun build.js --check",
    "release": "bun build.js --bump",
    "test": "bun test/run-all.js --all",
    "test:fast": "bun test/run-all.js --fast --all",
    "test:changed": "bun test/run-all.js",
    "ui": "bun test/ui-harness.js check"
  }
}
